Tree1 m=0 x=20  y=-10 z=0 h=10 degree=8 seed=0 r=0 tilt=60 twist=137.5 ratio=0.8 base=2 trunk=1 leaf=0.2
Tree1 m=0 x=20  y=10  z=0 h=10 degree=7 seed=0 r=0 tilt=60 twist=137.5 ratio=0.8 base=2 trunk=1 leaf=0.2
Tree1 m=0 x=-20 y=10  z=0 h=10 degree=6 seed=0 r=0 tilt=60 twist=137.5 ratio=0.8 base=2 trunk=1 leaf=0.2

